<exercises xml:id="s_func_transf_ex">
<exercise>
                <statement>

                <p>
                    The graph of the function <m>f(x)</m> is given below.
                    Sketch the graphs of the following functions and state the
                    transformation of <m>f(x)</m>.
                    
            <ol marker="(a)"><li>

                            <p>
                                <m>f(x)+1, f(x)-1, f(x+1), f(x-1)</m>
                            </p>
                                        </li>

            <li>

                            <p>
                                <m>2f(x), \dfrac{1}{2}f(x), f(2x), f(\dfrac{1}{2}x)</m>
                            </p>
                                        </li>

            <li>

                            <p>
                                <m>-f(x),f(-x)</m>
                            </p>
                                        </li></ol>
                            </p>
</statement>
            </exercise>
<exercise>
                <statement>

                <p>
                    The graph of the function <m>f(x)</m> is given below.
                    Sketch the graphs of the following functions and explain
                    which function transformations of <m>f(x)</m> (and in what
                    order) give <m>g(x)</m>.
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m>g(x)=-2f(x-1)+1</m>
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>g(x)=</m>
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>g(x)=</m>
                            </p>
                        </li>
                    </ol>
                </p>
                            </statement>
            </exercise>
<exercise>
                <statement>

                <p>
                    Determine whether the given functions are even, odd, or
                    neither.
                </p>
                            </statement>
            </exercise>
</exercises>
