<exercises xml:id="s_algebraic_func_ex">
<exercise>
                <statement>

                <p>
                    Find the implied domain of the following power functions.
                    
            <ol marker="(a)"><li>

                            <p>
                                <m>f_{1}(x)=\sqrt{2}x^{2/3}</m>
                                
                            </p>
                                        </li>

            <li>

                            <p>
                                <m>f_{2}(x)=-3x^{-3}</m>
                                
                            </p>
                                        </li>

            <li>

                            <p>
                                <m>f_{3}(x)=2x^{-5/2}</m>
                                
                            </p>
                                        </li>

            <li>

                            <p>
                                <m>f_{4}(x)=\dfrac{x^{1/4}}{4}</m>
                                
                            </p>
                                        </li></ol>
        
                    Then find <m>f_{1}(-8), f_{2}(-3), f_{3}(4), f_{4}(16)</m>.
                </p>
                            </statement>
                    <solution>
                        <p>
<ol marker="(a)">
                        <li>
                                    <p>
                                        The domain is <m>\mathbb{R}</m>.
                            </p>
                                </li>
                        <li>
                                    <p>
                                        The domain is
                                        <m>\mathbb{R}\setminus \{0\}</m>
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        The domain is <m>(0,\infty)</m>.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        The domain is <m>[0,\infty)</m>.
                                    </p>
                                </li>
                        <li>
                            <p>
                                <md>
                                    f_{1}(-8)=\sqrt{2}(-8)^{2/3}=\sqrt{2}((-2)^{3})^{2/3}=\sqrt{2}(-2)^{2}=4\sqrt{2}
                                </md>
                            </p>
                            <p>
                                <md>
                                    f_{2}(-3)=-3\cdot(-3)^{-3}=-3\cdot \dfrac{1}{(-3)^3}=-3\cdot \dfrac{1}{-27}=\dfrac{1}{9}
                                </md>
                            </p>
                            <p>
                                <md>
                                    f_{3}(4)=2\cdot 4^{-5/2}=2\cdot (2^{2})^{-5/2}=2\cdot 2^{(-5)}=2^{-4}=\dfrac{1}{16}
                                </md>
                            </p>
                            <p>
                                <md>
                                    f_{4}(16)=\dfrac{16^{1/4}}{4}=\dfrac{(2^4)^{1/4}}{4}=\dfrac{2}{4}=\dfrac{1}{2}.
                                </md>
                            </p>
                        </li>
                        </ol>
</p>
                    </solution>
            </exercise>
<exercise>
                <statement>

                <p>
                    Simplify the expression to one involving only positive
                    exponents.
                    Assume that everything is well-defined.
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m>\left(\dfrac{x^{-1/4}y}{xz^2}\right)^{-4}</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>\dfrac{(x^3y)^{-1}(8^{-1}x^4y^3)}{(2x^2y^{-3})^{-2}}</m>
                                
                            </p>
                        </li>
                    </ol>
                </p>
                            </statement>
                    <solution>
                        <p>
<ol marker="(a)">
                        <li>
                                    <p>
                                        <m>\left(\dfrac{x^{-1/4}y}{xz^2}\right)^{-4}=\dfrac{(x^{-1/4})^{-4}y^{-4}}{x^{-4}(z^2)^{-4}}=\dfrac{xy^{-4}}{x^{-4}z^{-8}}=\dfrac{xx^4z^8}{y^4}=\dfrac{x^5z^8}{y^4}.</m>
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        <m>\dfrac{(x^3y)^{-1}(8^{-1}x^4y^3)}{(2x^2y^{-3})^{-2}}=\dfrac{x^{-3}y^{-1}8^{-1}x^4y^3}{2^{-2}x^{-4}y^6}=\dfrac{xy^28^{-1}}{2^{-2}x^{-4}y^6}=\dfrac{xx^42^2}{8y^{6-2}}=\dfrac{x^5}{2y^4}.</m>
                                    </p>
                                </li>
                        </ol>
</p>
                    </solution>
            </exercise>
<exercise>
                <statement>

                <p>
                    Let <m>n</m> and <m>x</m> be positive integers.
                    Write the following expression
                    <m>\dfrac{\sqrt[3]{x^{6n}x^{-3n-9}}}{\sqrt{x^{2(n+2)}}}</m>
                    in the form <m>x^{k}</m>, for some integer <m>k</m>.
                    
                </p>
                            </statement>
<solution>
                        <p>
                            <m>\dfrac{\sqrt[3]{x^{6n}x^{-3n-9}}}{\sqrt{x^{2(n+2)}}}=\dfrac{x^{6n/3}x^{(-3n-9)/3}}{x^{2(n+2)/2}}=\dfrac{x^{2n}x^{-n-3}}{x^{n+2}}=\dfrac{x^{2n-n-3}}{x^{n+2}}=\dfrac{x^{n-3}}{x^{n+2}}=x^{(n-3)-(n+2)}=x^{-5}.</m>
                        </p>
                    </solution>
            </exercise>
<exercise>
                <statement>

                <p>
                    Determine the degree, leading coefficient, leading term and
                    constant term of the following polynomials.
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m>-(1-x)^{2}+2(x-1)(2x+1)-(x-2)(x+2)</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>(x-2)(x^{2}+2x+4)-(x-2)^{3}</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>(x^{2}+x-6)^{2}-2x(x+3)(x^{2}+1)</m>
                                
                            </p>
                        </li>
                    </ol>
                </p>
                            </statement>
                    <solution>
                        <p>
<ol marker="(a)">
                        <li>
                                    <md>
                                        &amp;-(1-x)^{2}+2(x-1)(2x+1)-(x-2)(x+2)\\&amp;=-(1-2x+x^{2})+2(2x^{2}+x-2x-1)-(x^{2}-4)\\&amp;=-1+2x-x^{2}+4x^{2}+2x-4x-2-x^{2}+4\\&amp;=2x^{2}+1
                                    </md>

                                    <p>
                                        The degree of the polynomial is 2, the
                                        leading coefficient is <m>2</m>, the
                                        leading term is <m>2x^{2}</m> and the
                                        constant term is <m>1</m>.
                                    </p>
                                </li>
                        <li>
                                    <md>
                                        &amp;(x-2)(x^{2}+2x+4)-(x-2)^{3}\\&amp;=(x^{3}-2^{3})-(x^{3}-6x^{2}+12x-8)\\&amp;=x^{3}-8-x^{3}+6x^{2}-12x+8\\&amp;=6x^{2}-12x
                                    </md>

                                    <p>
                                        The degree of the polynomial is 2, the
                                        leading coefficient is 6, the leading
                                        term is <m>6x^{2}</m> and the constant
                                        term is <m>0</m>.
                                    </p>
                                </li>
                        <li>
                                    <md>
                                        &amp;(x^{2}+x-6)^{2}-2x(x+3)(x^{2}+1)\\&amp;=(x^{4}+x^{2}+6^{2}+2x^{3}-12x^{2}-12x)-2x(x^{3}+x+3x^{2}+3)\\&amp;=x^{4}+2x^{3}-11x^{2}-12x+36-2x^{4}-2x^{2}-6x^{3}-6x\\&amp;=-x^{4}-4x^{3}-13x^{2}-18x+36
                                    </md>

                                    <p>
                                        The degree of the polynomial is 4, the
                                        leading coefficient is -1, the leading
                                        term is <m>-x^{4}</m> and the constant
                                        term is 36.
                                    </p>
                                </li>
                        </ol>
</p>
                    </solution>
            </exercise>
<exercise>
                <statement>

                <p>
                    Determine the values of <m>a,b,c</m> so that the polynomials
                    <m>f(x)</m> and <m>g(x)</m> are equal.
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m>f(x)=2(x-3)^{2}-4(x+1)</m>
                            </p>

                            <p>
                                <m>g(x)=(a-1)x^{2}+(b+5)x+c.</m>
                            </p>

                            
                        </li>

                        <li>
                            <p>
                                <m>f(x)=(x-3)(2x^{2}-4x+5)+(x+2)(x^{2}-3x+1)</m>
                            </p>

                            <p>
                                <m>g(x)=(a+b)x^{3}+(2a-c)x^{2}+(b+3c)x+11.</m>
                            </p>

                            
                        </li>
                    </ol>
                </p>
                            </statement>
                    <solution>
                        <p>
<ol marker="(a)">
                        <li>
                                    <p>
                                        Two polynomials are equal if the
                                        corresponding coefficients are equal.
                                        We have
                                        <m>f(x)=2x^{2}-12x+18-4x-4=2x^{2}-16x+14</m>,
                                        so we get <m>a-1=2, b+5=-16, c=14</m>,
                                        i.e.
                                        <m>a=3,b=-21,c=14</m>.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        We have
                                        <m>f(x)=2x^{3}-4x^{2}+5x-6x^{2}+12x-15+x^{3}-3x^{2}+x+2x^{2}-6x+2=3x^{3}-11x^{2}+12x-13</m>.
                                        Thus <m>a+b=3,2a-c=-11,b+3c=12</m>,
                                        i.e.,
                                        <m>a=-\dfrac{24}{5},b=\dfrac{39}{5},c=\dfrac{7}{5}</m>.
                                    </p>
                                </li>
                        </ol>
</p>
                    </solution>
            </exercise>
<exercise>
                <statement>

                <p>
                    Find the (real) roots of the following polynomials.
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m>x^{3}-2x^{2}-x+2</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>x^{3}-4x^{2}+x+6</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>x^{4}+x^{3}+2x-4</m>
                                
                            </p>
                        </li>
                    </ol>
                </p>
                            </statement>
                    <solution>
                        <p>
<ol marker="(a)">
                        <li>
                                    <p>
                                        <m>x^{3}-2x^{2}-x+2=0 \iff x^{2}(x-2)-(x-2)=0\iff (x-2)(x^{2}-1)=0\iff (x-2)(x-1)(x+1)=0</m>
                                        and therefore, the zeroes are
                                        <m>2,1,-1</m>.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        This polynomial does not factor as
                                        easily as the previous one.
                                        Using the Integer Root theorem, the
                                        possible integer solutions to the
                                        equation <m>x^{3}-4x^{2}+x+6=0</m> are
                                        the divisors of <m>6</m>, i.e.,
                                        <m>\pm1,\pm2,\pm3,\pm6</m>.
                                        Notice that <m>-1</m> is one solution.
                                        Then use long division of polynomials to
                                        divide the given polynomial by
                                        <m>x-(-1)=x+1</m>:
                                    </p>

                                    <p>
                                        <md>
                                            \begin{array}{r@{}l}&amp; \underline{x^2-5x+6} \\ x+1\,\big)\,&amp; x^3-4x^2+x+6 \\[1mm] &amp; \underline{x^3+x^2} \\[-1mm] &amp; \phantom{x^3+}(-5x^2+x) \\[1mm] &amp; \underline{\phantom{x^3+}(-5x^2-5x)} \\[-1mm] &amp; \phantom{x^3-4x^2+}(6x+6) \\[1mm] &amp; \underline{\phantom{x^3-4x^2+}(6x+6)} \\[-1mm] &amp; 0\end{array}.
                                        </md>
                                        Next, we solve the equation
                                        <m>x^{2}-5x+6=0\iff(x-3)(x-2)=0\iff x=3,x=2</m>.
                                    </p>

                                    <p>
                                        Thus, the roots of the polynomial are
                                        <m>-1,2,3</m>.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        Similarly, we notice that 1 is a
                                        solution to the equation
                                        <m>x^{4}+x^{3}+2x-4=0</m>.
                                        We use long division to divide the given
                                        polynomial by <m>x-1</m>:
                                    </p>

                                    <p>
                                        <md>
                                            \begin{array}{r@{}l}&amp; \underline{x^3+2x^2+2x+4} \\ x-1\,\big)\,&amp; x^4+x^3+0x^2+2x-4 \\[1mm] &amp; \underline{x^4-x^3} \\[-1mm] &amp; \phantom{x^4+}(2x^3+0x^2) \\[1mm] &amp; \underline{\phantom{x^4+}(2x^3-2x^2)} \\[-1mm] &amp; \phantom{x^4+x^3+}(2x^2+2x) \\[1mm] &amp; \underline{\phantom{x^4+x^3+}(2x^2-2x)} \\[-1mm] &amp; \phantom{x^4+x^3+0x^2+}(4x-4) \\[1mm] &amp; \underline{\phantom{x^4+x^3+0x^2+}(4x-4)} \\[-1mm] &amp; 0\end{array}.
                                        </md>
                                    </p>

                                    <p>
                                        Next, we solve the equation
                                        <m>x^{3}+2x^{2}+2x+4=0 \iff x^{2}(x+2)+2(x+2)=0\iff (x^{2}+2)(x+2)=0</m>.
                                        Since <m>x^{2}+2=0</m> has no real
                                        solutions, the only roots of the
                                        polynomial are 1 and -2.
                                    </p>

                                    <p>
                                        Note that if <m>x^{3}+2x^{2}+2x+4=0</m>
                                        was not easily factorizable, we would
                                        use the integer root theorem and long
                                        division, as previously.
                                    </p>
                                </li>
                        </ol>
</p>
                    </solution>
            </exercise>
<exercise>
                <statement>

                <p>
                    Classify the following functions as one of the following:
                    power functions, polynomial functions, rational functions,
                    algebraic functions that are none of the previous types.
                    Note that some functions belong to more than one function
                    class.
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m>f(x)=\sqrt{x}</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>f(x)=\sqrt{\pi}</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>f(x)=x^{2}</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>f(x)=2(x^{3/2}+1)</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>f(x)=2x^{5/2}-x^{3/2}+1</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>f(x)=\dfrac{1+x}{1+x^2}</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>f(x)=\dfrac{1+x}{1+\sqrt{x}}</m>
                                
                            </p>
                        </li>
                    </ol>
                </p>
                            </statement>
                    <solution>
                        <p>
<ol marker="(a)">
                        <li>
                                    <p>
                                        Power function.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        Polynomial function, power function,
                                        rational function.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        Polynomial function, power function,
                                        rational function.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        Algebraic function.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        Algebraic function.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        Rational function.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        Algebraic function.
                                    </p>
                                </li>
                        </ol>
</p>
                    </solution>
            </exercise>
<exercise>
                <statement>

                <p>
                    Find the (implied) domain and the zeroes (if any) of the
                    following functions.
                    <ol marker="(a)">
                        <li>
                            <p>
                                <m>f(x)=x^{2}-x+2</m>
                            </p>

                            
                        </li>

                        <li>
                            <p>
                                <m>f(x)=\dfrac{x^2-x-2}{5}</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>f(x)=\dfrac{x-2}{2x^2-3x+1}</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>f(x)=\dfrac{x-2}{x^2-4}</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>f(x)=\dfrac{x^2-1}{x^3-x^2+x-1}</m>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                <m>f(x)=\dfrac{x^2+1}{x^3-2x+1}</m>
                                
                            </p>
                        </li>
                    </ol>
                </p>
                            </statement>
                    <solution>
                        <p>
<ol marker="(a)">
                        <li>
                                    <p>
                                        This is a polynomial function
                                        (quadratic, to be specific) and
                                        therefore, the domain is
                                        <m>\mathbb{R}</m>.
                                    </p>

                                    <p>
                                        To find the zeroes, we have to solve the
                                        equation <m>x^{2}-x+2=0</m>.
                                        However, this equation has no real
                                        solutions, so the function has no
                                        zeroes.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        This is also a polynomial function and
                                        hence the domain is <m>\mathbb{R}</m>.
                                    </p>

                                    <p>
                                        The zeroes are <m>-1</m> and <m>2</m>,
                                        obtained by solving the equation
                                        <m>\dfrac{x^2-x-2}{5}=0</m>.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        This is a rational function that is
                                        defined for all real numbers such that
                                        <m>2x^{2}-3x+1\neq0</m>.
                                        The solutions to this equation are
                                        <m>x=1/2</m> and <m>x=1</m> and hence,
                                        the domain of the function is
                                        <m>\mathbb{R}\setminus \{1,\dfrac{1}{2}\}</m>.
                                    </p>

                                    <p>
                                        <m>\dfrac{x-2}{2x^2-3x+1}=0</m> whenever
                                        <m>x-2=0</m> or <m>x=2</m>.
                                        Therefore, the function has one zero
                                        <m>2</m>.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        <m>x^{2}-4=0</m> whenever
                                        <m>x=\pm 2</m>.
                                        Therefore, the domain of the function is
                                        <m>\mathbb{R}\setminus \{-2,2\}</m>.
                                    </p>

                                    <p>
                                        <m>\dfrac{x-2}{x^2-4}=0</m> whenever
                                        <m>x-2=0</m> or <m>x=2</m>.
                                        However, <m>2</m> is not in the domain
                                        of the function, and therefore the
                                        function has no zeroes.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        <md>
                                            x^{3}-x^{2}+x-1=0
                                        </md>
                                        <md>
                                            x^{2}(x-1)+(x-1)=0
                                        </md>
                                        <md>
                                            (x-1)(x^{2}+1)=0
                                        </md>
                                        <md>
                                            x=1
                                        </md>
                                        since <m>x^{2}+1\neq 0</m> for any real
                                        number <m>x</m>.
                                        Therefore, the domain of the function is
                                        <m>\mathbb{R}\setminus \{1\}</m>.
                                    </p>

                                    <p>
                                        <m>x^{2}-1=0</m> whenever <m>x^{2}=1</m>
                                        i.e., whenever <m>x=\pm1</m>.
                                        However, <m>1</m> is not in the domain
                                        of the function, and hence, the only
                                        zero of the function is <m>-1</m>.
                                    </p>
                                </li>
                        <li>
                                    <p>
                                        To find the domain, we need to solve the
                                        equation <m>x^{3}-2x+1=0</m>.
                                        First, notice that <m>x=1</m> is a
                                        solution.
                                        Then, using long division, we conclude
                                        that <m>x^{3}-2x+1=(x-1)(x^{2}+x-1)</m>.
                                        Solving <m>x^{2}+x-1=0</m>, we get
                                        <m>x=\dfrac{-1\pm\sqrt{5}}{2}</m>.
                                        Thus the domain of the function is
                                        <m>\mathbb{R}\setminus \{1,\dfrac{-1\pm\sqrt{5}}{2}\}</m>.
                                    </p>

                                    <p>
                                        To find the zeroes, we need to solve
                                        <m>\dfrac{x^2+1}{x^3-2x+1}=0</m>, which
                                        is equivalent to <m>x^{2}+1=0</m>.
                                        This equation has no real solutions and
                                        hence, the function has no zeroes.
                                    </p>
                                </li>
                        </ol>
</p>
                    </solution>
            </exercise>
<exercise>
                <statement>

                <p>
                    Determine whether the following statements are true or
                    false.
                    Justify your reasoning.
                    <ol marker="(a)">
                        <li>
                            <p>
                                If <m>f(x)=\sqrt{x-3}</m>, then the domain of
                                <m>f</m> is <m>[3,\infty)</m>.
                            </p>
                        </li>

                        <li>
                            <p>
                                The function <m>f(x)=\sqrt[3]{x-5}</m> has
                                domain <m>[5,\infty)</m>.
                            </p>
                        </li>

                        <li>
                            <p>
                                If <m>f(x)=\sqrt{(x-2)^{2}}</m>, then
                                <m>f(x)=x-2</m> for every <m>x</m>.
                            </p>
                        </li>

                        <li>
                            <p>
                                The functions
                                <md>
                                    f(x)=\frac{x^{2}-4}{x-2}\qquad\text{and}\qquad g(x)=x+2
                                </md>
                                are equal functions.
                            </p>
                        </li>

                        <li>
                            <p>
                                The domain of
                                <md>
                                    f(x)=\frac{\sqrt{x-2}}{x-5}
                                </md>
                                is <m>[2,5)\cup(5,\infty)</m>.
                            </p>
                        </li>

                        <li>
                            <p>
                                The function <m>f(x)=x^{5/2}-x^{3/2}</m> is a
                                power function.
                            </p>
                        </li>

                        <li>
                            <p>
                                The function <m>f(x)=\dfrac{x^3+x^2}{x}</m> is a
                                polynomial function.
                            </p>
                        </li>

                        <li>
                            <p>
                                The function <m>f(x)=x^{5/3}</m> is defined for
                                every real number <m>x</m>.
                            </p>

                            <p>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                The function <m>f(x)=x^{-2/3}</m> is defined at
                                <m>x=0</m>.
                            </p>
                        </li>

                        <li>
                            <p>
                                The domain of <m>f(x)=(x-2)^{-1/2}</m> is
                                <m>(2,\infty)</m>.
                            </p>
                        </li>

                        <li>
                            <p>
                                The function <m>f(x)=\sqrt[3]{x^{2}-4}</m> is
                                defined for every real number <m>x</m>.
                            </p>

                            <p>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                Every polynomial function is an algebraic
                                function.
                            </p>

                            <p>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                If <m>x-3</m> is a factor of <m>f(x)</m>, then
                                <m>f(3)=0</m>.
                            </p>

                            <p>
                                
                            </p>
                        </li>

                        <li>
                            <p>
                                The polynomial
                                <md>
                                    f(x)=x^{4}-16
                                </md>
                                has exactly two real zeros.
                            </p>

